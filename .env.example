# GEMINI_API_KEY: Required for Google AI Studio Developer API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# YOUTUBE_API_KEY: Optional YouTube Data API v3 key for live educational video recommendations in Explore Further.
YOUTUBE_API_KEY=""

# GOOGLE_GENAI_USE_VERTEXAI: Optional ("auto" | "true" | "false").
# Uses Application Default Credentials (ADC) via the Cloud Run attached service account or Workload Identity Federation.
# No downloadable service account JSON key files are used (compliant with iam.disableServiceAccountKeyCreation).
GOOGLE_GENAI_USE_VERTEXAI="auto"

# GOOGLE_CLOUD_PROJECT: Google Cloud project ID linked to your $300 Google Cloud Free Trial billing account.
GOOGLE_CLOUD_PROJECT="cs-project-wsjgygls"

# GOOGLE_CLOUD_LOCATION: Vertex AI region for Gemini publisher models (e.g., "us-central1" or "global").
GOOGLE_CLOUD_LOCATION="us-central1"

# ---------------------------------------------------------------------------
# Server-side authentication & AI usage controls
# ---------------------------------------------------------------------------

# Firebase Admin credentials (needed for durable per-user AI quotas in Firestore).
# Provide ONE of the following. Never commit the key itself.
#  - FIREBASE_SERVICE_ACCOUNT_JSON: the service-account JSON (raw or base64) stored as a secret env var.
#  - GOOGLE_APPLICATION_CREDENTIALS: path to a secret file, e.g. a Render Secret File at /etc/secrets/firebase-admin.json
# In production, AI endpoints return 503 until one of these is configured.
FIREBASE_SERVICE_ACCOUNT_JSON=""
# GOOGLE_APPLICATION_CREDENTIALS="/etc/secrets/firebase-admin.json"

# Optional: override the Firebase project used to verify ID tokens (defaults to firebase-applet-config.json).
# FIREBASE_PROJECT_ID=""

# Daily AI usage units per signed-in user (resets at midnight IST). Default 120.
AI_DAILY_UNIT_LIMIT="120"
# Per-user AI requests per minute (burst limit, per server process). Default 15.
AI_USER_REQUESTS_PER_MINUTE="15"
# Per-IP API requests per minute (per server process). Default 120.
API_IP_REQUESTS_PER_MINUTE="120"
# Reverse-proxy hops in front of the app, used to derive the client IP. Default 1.
TRUST_PROXY_HOPS="1"

# Extra allowed browser origins for the voice WebSocket (comma-separated). The app's own host is always allowed.
ALLOWED_ORIGINS=""

# Internal diagnostics (/api/usage, /api/capabilities, /api/vertex/*). Disabled unless "true"; admin UIDs only.
ENABLE_INTERNAL_DIAGNOSTICS="false"
ADMIN_UIDS=""
